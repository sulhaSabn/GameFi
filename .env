PORT=10000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/CryptoGame
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
APP_URL=http://localhost:10000
CORS_ORIGIN=http://localhost:5173

# SMTP - required for real email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Crypto Game <no-reply@example.com>"

# Optional admin bootstrap
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
